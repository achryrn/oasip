# OASIP configuration - copy to .env and fill in keys you have.
# Every service is optional; missing keys degrade gracefully.

# Storage: default is a zero-setup SQLite file. For PostgreSQL:
# OASIP_DATABASE_URL=postgresql+psycopg2://user:pass@localhost/oasip
# OASIP_DATABASE_URL=sqlite:///oasip.db

# --- API keys (all optional) ---
# SHODAN_API_KEY=          # 100 queries/month free (academic: full)
# CENSYS_API_ID=
# CENSYS_API_SECRET=       # 250 queries/month free
# BINARYEDGE_API_KEY=
# VIRUSTOTAL_API_KEY=      # 500 req/day free
# SECURITYTRAILS_API_KEY=  # 50 queries/month free
# HACKERTARGET_API_KEY=    # 100 queries/day free
# GITHUB_TOKEN=            # 5000 req/hour (code search REQUIRES a token)
# HIBP_API_KEY=            # domain search requires verification + key
# INTELX_API_KEY=          # free tier, capped results
# DEHASHED_EMAIL=
# DEHASHED_API_KEY=
# LEAKCHECK_API_KEY=

# --- behaviour ---
# OASIP_AUTHORIZED=0       # set 1 to allow scans without --authorized
# OASIP_CONCURRENCY=24
# OASIP_DNS_CONCURRENCY=60
# OASIP_MAX_HOSTS=5000
# OASIP_DEEP_CERT_LIMIT=250
# OASIP_SMTP_PROBE=0       # RCPT TO email validation (off by default)
